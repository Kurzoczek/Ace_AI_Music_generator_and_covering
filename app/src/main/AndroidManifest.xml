<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloading the models from Hugging Face (only after the user confirms the size and the source). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detecting mobile data (metered network) to warn before large downloads / honor "Wi-Fi only". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Progress / finished / overheating notifications (asked at runtime on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Long downloads and generation run in a foreground service, visible to the user. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Keeps the CPU running while the screen is off during generation (partial wake lock only). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      No storage permissions: input tracks are opened with the system file picker (Storage Access Framework)
      and results are saved through MediaStore (Music/ and Download/), which needs no permission on Android 10+.
    -->

    <application
        android:name=".AceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AceMusicGen"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only the app itself can start or control generation. -->
        <service
            android:name=".engine.GenerationService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>
</manifest>
